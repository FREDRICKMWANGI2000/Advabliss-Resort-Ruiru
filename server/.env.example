# ==============================================================================
# AdvaBliss Resort Ruiru — Backend Environment Variables (.env)
# ==============================================================================
# For local dev: copy this file to .env
# For production: set these in the Render Dashboard service environment settings.
# ==============================================================================

# Node Environment ('development', 'production', or 'test')
NODE_ENV=production

# Server listening port (Render assigns PORT automatically in production)
PORT=5000

# Resend API Key (https://resend.com/api-keys) — Keep secret, NEVER commit!
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender address on your verified domain in Resend
# Note: "onboarding@resend.dev" is for testing ONLY and can only deliver to the Resend account email.
# Production must use an address from a domain verified in Resend (e.g. reservations@advabliss.com).
# (Deprecated fallback alias: RESEND_FROM_EMAIL)
MAIL_FROM=onboarding@resend.dev

# Resort administrative inbox(es) receiving reservation and enquiry notices (comma-separated)
# (Deprecated fallback alias: RESORT_EMAIL)
MAIL_TO=fredifytechnologies@gmail.com

# Published Resend Admin Notification Template Aliases / IDs
# These should match the templates created in your Resend Dashboard.
RESEND_CONTACT_TEMPLATE_ID=website-enquiry-notification
RESEND_ACCOMMODATION_TEMPLATE_ID=reservation-inquiry
# (Deprecated fallback alias: RESEND_TABLE_TEMPLATE_ID)
RESEND_RESTAURANT_TEMPLATE_ID=table-reservation-notice
# Optional template for meetings & event enquiries:
RESEND_MEETING_TEMPLATE_ID=

# Allowed frontend origins for CORS (comma-separated, no trailing slashes)
# In production, must include your Vercel deployment URL and custom domain.
CORS_ORIGINS=https://advabliss-resort-ruiru.vercel.app,https://advabliss.com,https://www.advabliss.com,http://localhost:5173
