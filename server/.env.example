# ---- Server (copy to .env locally; set these in the Render dashboard in production) ----
NODE_ENV=production
# Render injects PORT automatically; only set locally (default 5000)
PORT=5000

# Resend (https://resend.com) API key — keep secret, never commit
RESEND_API_KEY=

# Verified sender address/domain in Resend, e.g. "AdvaBliss <bookings@yourdomain.com>".
# onboarding@resend.dev works only for testing and can only deliver to your own Resend account email.
MAIL_FROM=

# Inbox(es) that receive enquiries (comma separated)
RESORT_EMAIL=fredifytechnologies@gmail.com

# Published Resend template aliases (from the ADVABLISS template group)
RESEND_CONTACT_TEMPLATE_ID=website-enquiry-notification
RESEND_ACCOMMODATION_TEMPLATE_ID=reservation-inquiry
RESEND_RESTAURANT_TEMPLATE_ID=table-reservation-notice

# Allowed frontend origins for CORS (comma separated, no trailing slash), e.g. https://www.yourdomain.com
CORS_ORIGINS=
